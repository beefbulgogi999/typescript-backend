{
  "name": "typescript-backend",
  "version": "1.0.0",
  "description": "Making a TS server that points to a mongodb , via API calls",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "ts-node-dev --respawn src/server.ts",
